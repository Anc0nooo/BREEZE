<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ 包可见性：支付宝/微信 SDK 要能探测到客户端，否则只能走 H5 收银台 -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="hk.alipay.wallet" />
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipays" />
        </intent>
    </queries>


    <application
        android:name=".BreezeApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Breeze"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Breeze"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          微信支付回调入口。类名是微信 SDK 写死的约定：<applicationId>.wxapi.WXEntryActivity。
          debug 变体的 applicationId 是 com.pangguai.breeze.debug，所以这里写全名。
          （打 release 包时 applicationId 少 .debug，需要另建一份同名的类）
        -->
        <activity
            android:name="com.pangguai.breeze.debug.wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.pangguai.breeze.debug"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
